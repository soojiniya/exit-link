{
  "name": "exit-link-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "verify:layout": "tsx scripts/verify-layout.ts",
    "verify:state": "tsx scripts/verify-state.ts",
    "verify:public": "tsx scripts/verify-public.ts",
    "import:study": "tsx scripts/import-study.ts",
    "verify:study": "tsx scripts/verify-study.ts",
    "verify:replay": "tsx scripts/verify-replay.ts",
    "verify": "npm run typecheck && npm run verify:layout && npm run verify:state && npm run verify:public"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@xyflow/react": "^12.3.5",
    "lucide-react": "^0.460.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
