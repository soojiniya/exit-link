      "format": "uuid",
      "title": "Guidance Id",
      "type": "string"
    },
    "scenario_id": {
      "format": "uuid",
      "title": "Scenario Id",
      "type": "string"
    },
    "building_id": {
      "title": "Building Id",
      "type": "string"
    },
    "scenario_revision": {
      "minimum": 1,
      "title": "Scenario Revision",
      "type": "integer"
    },
    "route_version": {
      "minimum": 1,
      "title": "Route Version",
      "type": "integer"
    },
    "audience_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Audience Id",
      "type": "string"
    },
    "start_location": {
      "title": "Start Location",
      "type": "string"
    },
    "source_node": {
      "title": "Source Node",
      "type": "string"
    },
    "destination_node": {
      "title": "Destination Node",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "status": {
      "enum": [
        "route_found",
        "no_route"
      ],
      "title": "Status",
      "type": "string"
    },
    "path": {
      "items": {
        "type": "string"
      },
      "title": "Path",
      "type": "array"
    },
    "exit_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Id"
    },
    "distance_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
