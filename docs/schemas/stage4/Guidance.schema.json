      "type": "boolean"
    },
    "human_evacuation_verified": {
      "const": false,
      "default": false,
      "title": "Human Evacuation Verified",
      "type": "boolean"
    }
  },
  "required": [
    "scenario_id",
    "building_id",
    "scenario_revision",
    "route_version",
    "audience_id",
    "start_location",
    "source_node",
    "destination_node",
    "status",
    "path",
    "exit_id",
    "distance_m"
