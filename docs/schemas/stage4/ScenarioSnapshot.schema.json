{
  "$defs": {
    "DisasterEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "scenario_id": {
          "format": "uuid",
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_revision": {
          "minimum": 1,
          "title": "Scenario Revision",
          "type": "integer"
        },
        "event": {
          "enum": [
            "scenario_created",
            "hazards_changed",
            "route_calculated",
            "guidance_prepared",
            "guidance_delivery_observed"
          ],
          "title": "Event",
          "type": "string"
        },
        "origin": {
          "enum": [
            "simulation",
            "computation",
            "real_tcp_observation"
          ],
          "title": "Origin",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "scenario_id",
        "scenario_revision",
        "event",
        "origin"
      ],
      "title": "DisasterEvent",
      "type": "object"
    },
    "EvacuationPlan": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "format": "uuid",
          "title": "Scenario Id",
          "type": "string"
        },
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "scenario_revision": {
          "minimum": 1,
          "title": "Scenario Revision",
          "type": "integer"
        },
        "route_version": {
          "minimum": 1,
          "title": "Route Version",
          "type": "integer"
        },
        "start_location": {
          "title": "Start Location",
          "type": "string"
        },
        "status": {
          "enum": [
            "route_found",
            "no_route"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "enum": [
            "minimum_distance",
            "start_blocked",
            "no_available_exit"
          ],
          "title": "Reason",
          "type": "string"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "title": "Path",
          "type": "array"
        },
        "exit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Id"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ExitCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "calculated_at": {
          "format": "date-time",
          "title": "Calculated At",
          "type": "string"
        },
        "algorithm": {
          "const": "dijkstra",
          "default": "dijkstra",
          "title": "Algorithm",
          "type": "string"
        },
        "cost_unit": {
          "const": "m_assumed",
          "default": "m_assumed",
          "title": "Cost Unit",
          "type": "string"
        },
        "data_origin": {
          "const": "simulation",
          "default": "simulation",
          "title": "Data Origin",
          "type": "string"
        },
        "real_world_safety_verified": {
          "const": false,
          "default": false,
          "title": "Real World Safety Verified",
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "building_id",
        "scenario_revision",
        "route_version",
        "start_location",
        "status",
        "reason",
        "candidates"
      ],
      "title": "EvacuationPlan",
      "type": "object"
    },
    "ExitCandidate": {
      "additionalProperties": false,
      "properties": {
        "exit_id": {
          "title": "Exit Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "blocked",
            "unreachable"
          ],
          "title": "Status",
          "type": "string"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        }
      },
      "required": [
        "exit_id",
        "status"
      ],
      "title": "ExitCandidate",
      "type": "object"
    },
    "HazardUpdate": {
      "additionalProperties": false,
      "description": "Full replacement of synthetic hazards, not a partial patch.",
      "properties": {
        "data_origin": {
          "const": "simulation",
          "default": "simulation",
          "title": "Data Origin",
          "type": "string"
        },
        "fire_locations": {
          "items": {
            "type": "string"
          },
          "title": "Fire Locations",
          "type": "array"
        },
        "dangerous_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Dangerous Nodes",
          "type": "array"
        },
        "blocked_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Blocked Nodes",
          "type": "array"
        },
        "blocked_passages": {
          "items": {
            "$ref": "#/$defs/Passage"
          },
          "title": "Blocked Passages",
          "type": "array"
        }
      },
      "title": "HazardUpdate",
      "type": "object"
    },
    "JsonValue": {},
    "Passage": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Passage",
      "type": "object"
    },
    "ScenarioState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scenario_id": {
          "format": "uuid",
          "title": "Scenario Id",
          "type": "string"
        },
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "hazards": {
          "$ref": "#/$defs/HazardUpdate"
        },
        "data_origin": {
          "const": "simulation",
          "default": "simulation",
          "title": "Data Origin",
          "type": "string"
        },
        "real_world_safety_verified": {
          "const": false,
          "default": false,
          "title": "Real World Safety Verified",
          "type": "boolean"
        }
      },
      "required": [
        "building_id"
      ],
      "title": "ScenarioState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ScenarioState"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/EvacuationPlan"
      },
      "title": "Plans",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/DisasterEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "state",
    "plans",
    "events"
  ],
  "title": "ScenarioSnapshot",
  "type": "object"
}
