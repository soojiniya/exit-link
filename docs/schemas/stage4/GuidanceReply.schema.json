{
  "$defs": {
    "Guidance": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exit_link.evacuation_guidance",
          "default": "exit_link.evacuation_guidance",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "guidance_id": {
          "format": "uuid",
          "title": "Guidance Id",
          "type": "string"
        },
        "scenario_id": {
          "format": "uuid",
          "title": "Scenario Id",
          "type": "string"
        },
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "scenario_revision": {
          "minimum": 1,
          "title": "Scenario Revision",
          "type": "integer"
        },
        "route_version": {
          "minimum": 1,
          "title": "Route Version",
          "type": "integer"
        },
        "audience_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Audience Id",
          "type": "string"
        },
        "start_location": {
          "title": "Start Location",
          "type": "string"
        },
        "source_node": {
          "title": "Source Node",
          "type": "string"
        },
        "destination_node": {
          "title": "Destination Node",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "status": {
          "enum": [
            "route_found",
            "no_route"
          ],
          "title": "Status",
          "type": "string"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "title": "Path",
          "type": "array"
        },
        "exit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Id"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distance M"
        },
        "data_origin": {
          "const": "simulation",
          "default": "simulation",
          "title": "Data Origin",
          "type": "string"
        },
        "real_world_safety_verified": {
          "const": false,
          "default": false,
          "title": "Real World Safety Verified",
          "type": "boolean"
        },
        "human_evacuation_verified": {
          "const": false,
          "default": false,
          "title": "Human Evacuation Verified",
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "building_id",
        "scenario_revision",
        "route_version",
        "audience_id",
        "start_location",
        "source_node",
        "destination_node",
        "status",
        "path",
        "exit_id",
        "distance_m"
      ],
      "title": "Guidance",
      "type": "object"
    },
    "GuidanceReceipt": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "scenario_id": {
          "format": "uuid",
          "title": "Scenario Id",
          "type": "string"
        },
        "audience_id": {
          "title": "Audience Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "applied",
            "stale",
            "duplicate",
            "version_conflict",
            "publisher_conflict"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "received_scenario_revision": {
          "title": "Received Scenario Revision",
          "type": "integer"
        },
        "received_route_version": {
          "title": "Received Route Version",
          "type": "integer"
        },
        "latest_scenario_revision": {
          "title": "Latest Scenario Revision",
          "type": "integer"
        },
        "latest_route_version": {
          "title": "Latest Route Version",
          "type": "integer"
        },
        "latest_guidance_id": {
          "format": "uuid",
          "title": "Latest Guidance Id",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "human_evacuation_verified": {
          "const": false,
          "default": false,
          "title": "Human Evacuation Verified",
          "type": "boolean"
        }
      },
      "required": [
        "message_id",
        "scenario_id",
        "audience_id",
        "disposition",
        "received_scenario_revision",
        "received_route_version",
        "latest_scenario_revision",
        "latest_route_version",
        "latest_guidance_id",
        "content_digest"
      ],
      "title": "GuidanceReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "guidance_reply",
      "default": "guidance_reply",
      "title": "Type",
      "type": "string"
    },
    "node": {
      "title": "Node",
      "type": "string"
    },
    "queried_message_id": {
      "format": "uuid",
      "title": "Queried Message Id",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuidanceReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Guidance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "node",
    "queried_message_id"
  ],
  "title": "GuidanceReply",
  "type": "object"
}
