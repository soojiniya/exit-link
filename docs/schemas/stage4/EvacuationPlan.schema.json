{
  "$defs": {
    "ExitCandidate": {
      "additionalProperties": false,
      "properties": {
        "exit_id": {
          "title": "Exit Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "blocked",
            "unreachable"
          ],
          "title": "Status",
          "type": "string"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        }
      },
      "required": [
        "exit_id",
        "status"
      ],
      "title": "ExitCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "format": "uuid",
      "title": "Scenario Id",
      "type": "string"
    },
    "building_id": {
      "title": "Building Id",
      "type": "string"
    },
    "scenario_revision": {
      "minimum": 1,
      "title": "Scenario Revision",
      "type": "integer"
    },
    "route_version": {
      "minimum": 1,
      "title": "Route Version",
      "type": "integer"
    },
    "start_location": {
      "title": "Start Location",
      "type": "string"
    },
    "status": {
      "enum": [
        "route_found",
        "no_route"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "enum": [
        "minimum_distance",
        "start_blocked",
        "no_available_exit"
      ],
      "title": "Reason",
      "type": "string"
    },
    "path": {
      "items": {
        "type": "string"
      },
      "title": "Path",
      "type": "array"
    },
    "exit_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Id"
    },
    "distance_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distance M"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ExitCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "algorithm": {
      "const": "dijkstra",
      "default": "dijkstra",
      "title": "Algorithm",
      "type": "string"
    },
    "cost_unit": {
      "const": "m_assumed",
      "default": "m_assumed",
      "title": "Cost Unit",
      "type": "string"
    },
    "data_origin": {
      "const": "simulation",
      "default": "simulation",
      "title": "Data Origin",
      "type": "string"
    },
    "real_world_safety_verified": {
      "const": false,
      "default": false,
      "title": "Real World Safety Verified",
      "type": "boolean"
    }
  },
  "required": [
    "scenario_id",
    "building_id",
    "scenario_revision",
    "route_version",
    "start_location",
    "status",
    "reason",
    "candidates"
  ],
  "title": "EvacuationPlan",
  "type": "object"
}
